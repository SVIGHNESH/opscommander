# Copy to .env and source it (or export) before running against real AWS.

# "mock" (default) uses in-repo fakes; "aws" talks to real services.
OPSCOMMANDER_MODE=mock

# --- AWS / Bedrock ---------------------------------------------------------
AWS_REGION=us-east-1
# On Bedrock the Anthropic model id is prefixed with "anthropic.".
OPSCOMMANDER_BEDROCK_MODEL=anthropic.claude-opus-4-8
OPSCOMMANDER_BEDROCK_EFFORT=high
OPSCOMMANDER_BEDROCK_MAX_TOKENS=2048

# --- Persistence -----------------------------------------------------------
OPSCOMMANDER_DDB_TABLE=opscommander-incidents
OPSCOMMANDER_S3_BUCKET=opscommander-reports
OPSCOMMANDER_DATA_DIR=./data

# --- Notifications ---------------------------------------------------------
OPSCOMMANDER_SNS_TOPIC_ARN=
OPSCOMMANDER_SLACK_WEBHOOK=

# --- Approval policy -------------------------------------------------------
# Safe actions at/below this severity are auto-approved; anything riskier
# (or more severe) escalates to a human.
OPSCOMMANDER_AUTO_APPROVE_SEVERITY=High

# --- Logging ---------------------------------------------------------------
OPSCOMMANDER_LOG_LEVEL=INFO
